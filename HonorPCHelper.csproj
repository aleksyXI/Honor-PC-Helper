<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.9.4</Version>
    <AssemblyName>HonorPCHelper</AssemblyName>
    <RootNamespace>HonorPCHelper</RootNamespace>
    <ApplicationIcon>Assets\HonorPCHelper.ico</ApplicationIcon>

    <!-- Фоновое приложение с крошечной кучей: параллельный сборщик мусора
         держал бы лишний поток и лишнюю память без всякой пользы. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Тексты интерфейса приложение подставляет само; локализованные ресурсы
         зависимостей только увеличивают portable-файл. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="OSDIcons\*.png">
      <LogicalName>HonorPCHelper.OSDIcons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="OSDRuntime\*.dll">
      <LogicalName>HonorPCHelper.Native.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
